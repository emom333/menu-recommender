{
  "_comment": "Field definitions for the Dentec Dental Laboratory prescription form (lab slip). Labels are matched case-insensitively and tolerate small OCR errors. Edit the label lists to tune recognition for your printed form. 'billing_rules' only SUGGEST invoice lines; a person always reviews and approves them.",
  "text_fields": [
    {"key": "doctor", "label": "Doctor", "group": "Office Information", "labels": ["Doctor", "Dentist Name"]},
    {"key": "office", "label": "Office", "group": "Office Information", "labels": ["Office", "Practice"]},
    {"key": "phone", "label": "Phone Number", "group": "Office Information", "labels": ["Phone", "Tel", "Phone No"]},
    {"key": "address", "label": "Address", "group": "Office Information", "labels": ["Address", "Addr"]},
    {"key": "patient_name", "label": "Patient Name", "group": "Patient Information", "labels": ["Patient", "Patient Name", "Pt"]},
    {"key": "sex", "label": "Sex", "group": "Patient Information", "labels": ["Sex", "Gender"]},
    {"key": "age", "label": "Age", "group": "Patient Information", "labels": ["Age"]},
    {"key": "date", "label": "Date", "group": "Patient Information", "labels": ["Date"], "kind": "date"},
    {"key": "due_date", "label": "Due Date", "group": "Patient Information", "labels": ["Due Date", "Due"], "kind": "date"},
    {"key": "buccal_margin", "label": "Buccal Margin Measurement", "group": "Restoration Information", "labels": ["Buccal Margin", "Buccal"]},
    {"key": "metal_design", "label": "Metal Design", "group": "Restoration Information", "labels": ["Metal Design"]},
    {"key": "pontic_design", "label": "Pontic Design", "group": "Restoration Information", "labels": ["Pontic Design", "Pontic"]},
    {"key": "occlusal_design", "label": "Occlusal Design", "group": "Restoration Information", "labels": ["Occlusal Design", "Occlusal"]},
    {"key": "shade", "label": "Shade Selection", "group": "Restoration Information", "labels": ["Shade"]},
    {"key": "tooth_numbers", "label": "Tooth Numbers (written)", "group": "Additional Information", "labels": ["Tooth #", "Tooth No", "Teeth", "Tooth"]},
    {"key": "license", "label": "License Number", "group": "Additional Information", "labels": ["License", "Lic", "License No"]},
    {"key": "instructions", "label": "Instructions", "group": "Additional Information", "labels": ["Instructions", "Notes", "Remarks"]}
  ],
  "checkboxes": [
    {"key": "bite_block", "label": "Bite Block", "group": "Procedure"},
    {"key": "metal_try_in", "label": "Metal Try-In", "group": "Procedure"},
    {"key": "teeth_try_in", "label": "Teeth Try-In", "group": "Procedure"},
    {"key": "custom_shade", "label": "Custom Shade", "group": "Procedure"},
    {"key": "finish", "label": "Finish", "group": "Procedure"},
    {"key": "dr_die_trim", "label": "Dr. Die Trim", "group": "Procedure"},
    {"key": "high_noble", "label": "High Noble", "group": "Restoration Information"},
    {"key": "noble_alloy", "label": "Noble", "group": "Restoration Information", "occurrence": 1},
    {"key": "non_precious_alloy", "label": "Non-Precious", "group": "Restoration Information", "occurrence": 1},
    {"key": "porcelain_butt_margin", "label": "Porcelain Butt Margin", "group": "Restoration Information"},
    {"key": "metal_margin", "label": "Metal Margin", "group": "Restoration Information"},
    {"key": "fud", "label": "FUD", "group": "Denture"},
    {"key": "fld", "label": "FLD", "group": "Denture"},
    {"key": "pud", "label": "PUD", "group": "Denture"},
    {"key": "pld", "label": "PLD", "group": "Denture"},
    {"key": "flexible", "label": "Flexible", "group": "Denture"},
    {"key": "metal_framework", "label": "Metal Framework", "group": "Denture"},
    {"key": "reline", "label": "Reline", "group": "Denture"},
    {"key": "repair", "label": "Repair", "group": "Denture"},
    {"key": "pfm", "label": "PFM", "group": "Restoration Category"},
    {"key": "gold_55", "label": "55% Gold", "group": "Restoration Category"},
    {"key": "gold_2", "label": "2% Gold", "group": "Restoration Category"},
    {"key": "non_precious", "label": "Non-Precious", "group": "Restoration Category", "occurrence": 2},
    {"key": "noble", "label": "Noble", "group": "Restoration Category", "occurrence": 2},
    {"key": "emax_press", "label": "E.max Press", "group": "Restoration Category"},
    {"key": "zirconia_layered", "label": "Zirconia Layered", "group": "Restoration Category"},
    {"key": "emax_cad", "label": "E.max CAD", "group": "Restoration Category"},
    {"key": "zirconia_full_contour", "label": "Zirconia Full Contour", "group": "Restoration Category"}
  ],
  "tooth_chart": {"anchor_labels": ["Upper", "Lower", "Tooth Chart"]},
  "signature": {"labels": ["Signature", "Doctor Signature", "Dr. Signature"]},
  "billing_rules": [
    {"when_all": ["bite_block"], "procedure": "Bite Block", "per_arch": true},
    {"when_all": ["teeth_try_in"], "procedure": "Teeth Try-In", "per_arch": true},
    {"when_all": ["finish"], "when_any": ["fud", "fld"], "when_none": ["pud", "pld"], "procedure": "Full Denture Finish", "per_arch": true, "arch_from": {"fud": "Upper", "fld": "Lower"}},
    {"when_all": ["finish", "flexible"], "when_any": ["pud", "pld"], "procedure": "Flexible Partial", "per_arch": true, "arch_from": {"pud": "Upper", "pld": "Lower"}},
    {"when_all": ["finish", "metal_framework"], "when_any": ["pud", "pld"], "when_none": ["flexible"], "procedure": "Metal Partial", "per_arch": true, "arch_from": {"pud": "Upper", "pld": "Lower"}},
    {"when_all": ["finish"], "when_any": ["pud", "pld"], "when_none": ["flexible", "metal_framework"], "procedure": "Acrylic Partial Finish", "per_arch": true, "arch_from": {"pud": "Upper", "pld": "Lower"}},
    {"when_all": ["reline"], "procedure": "Reline", "per_arch": true},
    {"when_all": ["repair"], "procedure": "Repair", "per_arch": true},
    {"when_all": ["zirconia_full_contour"], "procedure": "Full Zirconia Crown", "per_tooth": true},
    {"when_all": ["zirconia_layered"], "procedure": "Porcelain Zirconia Crown", "per_tooth": true},
    {"when_any": ["emax_press", "emax_cad"], "procedure": "E.Max Crown", "per_tooth": true},
    {"when_any": ["pfm", "gold_55", "gold_2", "non_precious", "noble"], "when_none": ["zirconia_full_contour", "zirconia_layered", "emax_press", "emax_cad"], "procedure": "PFM Crown", "per_tooth": true}
  ]
}
